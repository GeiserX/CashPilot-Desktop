# Local agent working dirs. This repository is PUBLIC, and these hold local
# agent state -- task tracker, session notes, tool config -- that is useful on
# one machine and has no business being published. (.omc/ already above.)
.agents/
# .beads/ commits only its scaffolding (config.yaml, README.md, hooks/,
# metadata.json, .gitignore). The tracker data lives in a private Dolt remote
# (sync.remote in .beads/config.yaml) and never enters this repository.
.beads/issues.jsonl
.beads/interactions.jsonl
.beads/events.jsonl
.beads/dolt/
.beads/embeddeddolt/
.beads/backup/
.beads/*.db
.beads/.beads-credential-key
.beads/.local_version
.claude/
.codex/

# Compiled output for the browser-free render harness (frontend/scripts/*.mjs).
/frontend/.harness-build/
